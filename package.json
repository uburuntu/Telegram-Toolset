{
  "name": "telegram-toolset",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.2.0",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "npm run test:unit && npm run test:component",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:unit:coverage": "vitest run --config vitest.config.unit.ts --coverage",
    "test:component": "vitest run --config vitest.config.component.ts",
    "test:component:coverage": "vitest run --config vitest.config.component.ts --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "npm run test:unit:coverage && npm run test:component:coverage",
    "check:i18n": "node scripts/check-i18n.js"
  },
  "dependencies": {
    "idb": "8.0.3",
    "jszip": "3.10.1",
    "pinia": "4.0.2",
    "telegram": "2.26.22",
    "uuid": "14.0.1",
    "vue": "3.5.40",
    "vue-i18n": "11.4.6",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "autoprefixer": "10.5.4",
    "jsdom": "29.1.1",
    "postcss": "8.5.20",
    "surge": "0.33.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.7"
  }
}
