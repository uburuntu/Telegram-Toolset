{
  "name": "telegram-toolset",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "npm run test:unit && npm run test:component",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:unit:coverage": "vitest run --config vitest.config.unit.ts --coverage",
    "test:component": "vitest run --config vitest.config.component.ts",
    "test:component:coverage": "vitest run --config vitest.config.component.ts --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "npm run test:unit:coverage && npm run test:component:coverage",
    "check:i18n": "node scripts/check-i18n.js"
  },
  "dependencies": {
    "idb": "8.0.3",
    "jszip": "3.10.1",
    "pinia": "3.0.4",
    "telegram": "2.26.22",
    "uuid": "14.0.0",
    "vue": "3.5.33",
    "vue-i18n": "11.4.0",
    "vue-router": "5.0.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "4.2.4",
    "@types/node": "25.6.0",
    "@vitejs/plugin-vue": "6.0.6",
    "@vitest/coverage-v8": "4.1.5",
    "@vue/test-utils": "2.4.8",
    "@vue/tsconfig": "0.9.1",
    "autoprefixer": "10.5.0",
    "jsdom": "29.0.2",
    "postcss": "8.5.10",
    "tailwindcss": "4.2.4",
    "typescript": "6.0.3",
    "vite": "8.0.10",
    "vitest": "4.1.5",
    "vue-tsc": "3.2.7"
  }
}
