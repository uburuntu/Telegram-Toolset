{
  "name": "telegram-toolset",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.2.0",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "brand:generate": "node scripts/generate-brand-assets.mjs && node scripts/generate-social-preview.mjs",
    "social:generate": "node scripts/generate-social-preview.mjs",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "npm run test:unit && npm run test:component",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:unit:coverage": "vitest run --config vitest.config.unit.ts --coverage",
    "test:component": "vitest run --config vitest.config.component.ts",
    "test:component:coverage": "vitest run --config vitest.config.component.ts --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:dist": "playwright test --config playwright.dist.config.ts",
    "test:coverage": "npm run test:unit:coverage && npm run test:component:coverage",
    "check:i18n": "node scripts/check-i18n.js"
  },
  "dependencies": {
    "@mtcute/html-parser": "0.32.4",
    "@mtcute/web": "0.32.4",
    "idb": "8.0.4",
    "jszip": "3.10.2",
    "pinia": "4.0.3",
    "uuid": "14.0.2",
    "vue": "3.5.43",
    "vue-i18n": "11.4.13",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.3",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "autoprefixer": "10.6.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.2",
    "postcss": "8.5.29",
    "surge": "0.44.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.12"
  }
}
